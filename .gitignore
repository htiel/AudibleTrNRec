.github/agents/

# Private alpha personal runtime state. Production code stores this outside the
# repository under %LOCALAPPDATA%, and these patterns are defense in depth.
.local-data/
local-data/
**/.local-data/
**/local-data/
*.sqlite
*.sqlite3
*.sqlite3-*
credentials.bin
identity.bin

# Visual-capture artifacts (issue #14). A screenshot of the running app is an
# unprotected plaintext copy of whatever was on screen, so capture output
# folders and images are never tracked anywhere in this repository.
.capture-out/
capture-out/
screenshots/
**/.capture-out/
**/capture-out/
**/screenshots/
*.png
